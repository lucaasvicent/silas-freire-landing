# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# --- Assistente de IA (Groq, plano gratuito) -----------------------------------
# Crie a chave em https://console.groq.com/keys — ela fica só no servidor.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b
# Modelo menor usado automaticamente se o principal atingir o limite gratuito.
AI_FALLBACK_MODEL=openai/gpt-oss-20b

# Outros provedores compatíveis funcionam trocando URL, chave e modelo.
# Ex.: DeepSeek (pago) → https://api.deepseek.com/chat/completions + deepseek-chat

# --- Google Analytics ----------------------------------------------------------
# ID de medição do GA4 (formato G-XXXXXXXXXX). Vazio = GA desativado.
NEXT_PUBLIC_GA_ID=
